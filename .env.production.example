# ==========================================
# DISCOVER KARABAKH - PRODUCTION ENV CONFIG
# (Coolify Environment Variables)
# ==========================================

NODE_ENV=production
PORT=4000

# Databaza təhlükəsiz parolu (MySQL üçün)
MYSQL_ROOT_PASSWORD=SuperSecretPassword123!
DATABASE_URL=mysql://root:SuperSecretPassword123!@mysql:3306/discoverkarabakh

# Redis URL (Coolify daxili container)
REDIS_URL=redis://redis:6379

# Auth & Security
JWT_SECRET=ChangeThisToA32ByteLongRandomStringForProduction!
JWT_EXPIRES_IN=7d

# Frontend Domenləri (Vercel-dəki domenləriniz)
FRONTEND_WEB_URL=https://discoverkarabakh.az
FRONTEND_VENDOR_URL=https://vendor.discoverkarabakh.az
FRONTEND_ADMIN_URL=https://admin.discoverkarabakh.az

# Cloudflare R2 / AWS S3 Storage (Fayl Yükləmələri üçün - optional)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=discoverkarabakh-bucket
S3_PUBLIC_URL=https://pub-<ID>.r2.dev

# Bank & Payment Provider (Azericard / MilliBank)
AZERICARD_API_URL=https://testmpi.3dsecure.az/cgi-bin/cgi_link
AZERICARD_TERMINAL=your_terminal_id
AZERICARD_MERCH_NAME=DISCOVERKARABAKH
AZERICARD_MERCH_URL=https://discoverkarabakh.az
